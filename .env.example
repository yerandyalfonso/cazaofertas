# URL del proyecto, sin /rest/v1 (ejemplo: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
# Chat privado tuyo para avisos de cron fallido (habla con @userinfobot o /start al bot)
TELEGRAM_ADMIN_CHAT_ID=
# Canal o grupo para alertas de chollos (ej: -1001234567890 o @mi_canal)
# Grupo con temas: t.me/c/4351769316 → -1004351769316 (botones inline)
TELEGRAM_CHANNEL_ID=
# Canal público de difusión (mismas ofertas, links en el texto para copiar)
# TELEGRAM_PUBLIC_CHANNEL_ID=@cazador_de_ofertas
TELEGRAM_PUBLIC_CHANNEL_ID=
# Temas por slug de categoría (opcional; hay defaults en código).
# Formato: slug:thread_id,slug:thread_id
# TELEGRAM_TOPIC_MAP=tecnologia:5,moda:6,hogar:11
# Tema dedicado «Otros» (https://t.me/c/4351769316/231). Default: 231
# TELEGRAM_TOPIC_OTROS=231
# Score mínimo legacy (ya no filtra el canal; se usa TELEGRAM_MIN_DISCOUNT_PERCENT).
TELEGRAM_MIN_SCORE=75
# Descuento mínimo (%) para encolar/publicar en Telegram — todas las tiendas.
# Preferible configurarlo en Admin → Ajustes. Default 20.
TELEGRAM_MIN_DISCOUNT_PERCENT=20
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/cazandor_de_ofertas_bot

# --- Facebook Page (Graph API, gratis) ---
# Se publica el mismo lote que Telegram (no al detectar). Si Meta falla, Telegram sigue.
# 1) Crea una app en https://developers.facebook.com/apps (tipo Business).
# 2) Graph API Explorer → token de USUARIO con:
#    pages_show_list, pages_manage_posts, pages_read_engagement
# 3) Convierte el token de usuario a larga duración (~60 días):
#    GET https://graph.facebook.com/v23.0/oauth/access_token
#      ?grant_type=fb_exchange_token
#      &client_id={APP_ID}&client_secret={APP_SECRET}
#      &fb_exchange_token={TOKEN_CORTO_DE_USUARIO}
# 4) Con ese token: GET /me/accounts → copia el `id` de la Página y su `access_token`.
#    Ese Page token (obtenido desde un user token largo) no caduca en la práctica.
#    Más estable: Business Manager → System User → token de la Página.
# 5) Añade las mismas variables en Vercel si usas “Enviar lote ahora” desde admin.
# FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram Business / Creator vinculado a la Página (Graph: page?fields=instagram_business_account).
# Permisos del token: instagram_basic + instagram_content_publish (+ pages_read_engagement).
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# URL canónica del sitio (canonicals, OG, sitemap). Ej: https://cazaoferta.es
NEXT_PUBLIC_SITE_URL=
# Handle de redes para carruseles y CTAs (ej: @cazaoferta)
NEXT_PUBLIC_SOCIAL_HANDLE=@cazaoferta

AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=ES

# Días agotado en Amazon antes de desactivar el producto en el catálogo (default 14)
OUT_OF_STOCK_DEACTIVATE_DAYS=14
# Fallos de scrape consecutivos del mismo ASIN antes de desactivar (cron local).
ASIN_SCRAPE_FAIL_THRESHOLD=2

# Kiabi — chollos de moda (cron local: npm run cron:local:kiabi)
KIABI_DEALS_ENABLED=0
KIABI_MIN_DISCOUNT_PERCENT=10
# 1 = solo productos nuevos (+ bajadas de precio en listado); 0 = también re-sincroniza existentes
KIABI_NEW_PRODUCTS_ONLY=1
# Si DataDome bloquea Node, usa esta lista JSON como respaldo (ruta relativa al repo)
# KIABI_FALLBACK_ITEMS_JSON=scripts/local-cron/.kiabi-browser-items.json
# Máximo de productos a descubrir por feed (default 100; promociones suele tener ~81)
# KIABI_DISCOVERY_MAX_ITEMS=100
# Opcional: cookies del navegador (archivo con cabecera Cookie o Netscape)
# KIABI_COOKIES_FILE=
# Feed principal de promociones con precio tachado (hasta -50%)
# KIABI_FEED_URLS=https://www.kiabi.es/promociones_464410

# Miravia — ofertas flash (misma cadencia que Amazon flash-deals, cada ~3 min)
# MIRAVIA_DEALS_ENABLED=1
# MIRAVIA_DISCOVERY_MAX_ITEMS=60
# MIRAVIA_FLASH_LIMIT=3
# MIRAVIA_FLASH_UPDATE_LIMIT=2
# MIRAVIA_MIN_DISCOUNT_PERCENT=15
# Umbral score Telegram solo Miravia (default 55; Amazon sigue TELEGRAM_MIN_SCORE=75)
# MIRAVIA_TELEGRAM_MIN_SCORE=55
# Tras flash-deals ya no se envía Telegram al instante (solo encola).
# El lote al grupo lo hace check-prices cuando toca el intervalo del admin (p. ej. 4 h).
# TELEGRAM_FLUSH_RESCHEDULE_MINUTES ya no dispara envíos parciales (reservado).

# Comentarios en artículos — aviso Telegram al admin (TELEGRAM_ADMIN_CHAT_ID)

# Cupones — Chollos de Hoy
# COUPON_DISCOVERY_ENABLED=1
# Scrape tiendas (Amazon clip / Kiabi / Miravia…). 0 = solo cupones manuales en /admin/coupons
# COUPON_SCRAPE_ENABLED=1
# Miravia Centro de cupones (requiere Chrome en el Mac del cron):
# MIRAVIA_COUPON_CATALOGUE_URL=https://www.miravia.es/ch/coupon-catalogue/coupon-catalogue
# MIRAVIA_COUPON_MAX_PAGES=8
# AMAZON_COUPON_DEALS_URL=https://www.amazon.es/deals?ref_=nav_cs_gb&bubble-id=deals-collection-coupons
# AMAZON_COUPON_ENRICH_MAX=40
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Manual: npm run coupons:discover  |  cron: npm run cron:local:coupons
# Admin: /admin/coupons
#
# Awin opcional (off por defecto): COUPON_AWIN_ENABLED=1
# AWIN_PUBLISHER_ID=
# AWIN_API_TOKEN=
# AWIN_REGION=ES
# AWIN_MEMBERSHIP=joined
# AWIN_MAX_PAGES=5
# AWIN_PAGE_SIZE=100

# Carrefour: desactivado (Cloudflare bloquea scrape automático). Los productos CF- en catálogo
# se gestionan manualmente; retailer sigue disponible en admin sin extracción automática.

# auto = Creators (si hay keys) → Keepa → scraper HTML
# Para ofertas flash / «ventas rápidas» usa html (precio de la ficha Amazon).
PRICE_PROVIDER=html

# Flash cron local (cada 3 min): departamentos rotados con peso (Belleza/Moda más a menudo).
# Goldbox/deals solo de vez en cuando (sesgan a Tecnología/Hogar).
# Lista fija opcional (coma o saltos de línea). Si está vacía, usa la rotación interna.
# AMAZON_FLASH_FEED_URLS=
# Cuántos departamentos scrapear por pasada (default 3).
# AMAZON_FLASH_DEPARTMENT_FEEDS_PER_RUN=3
# ASINs nuevos a insertar por pasada flash (default 4; baja a 3 si hay denegaciones).
# AMAZON_FLASH_INSERT_LIMIT=4

# CP de entrega en amazon.es (fuerza precios con IVA desde IPs fuera de ES, p.ej. Vercel).
# AMAZON_ES_ZIP=28001

# Bright Data — proxy residencial para scrape Amazon en producción (Vercel).
# En el panel: Residential → Overview → host, user, password.
# Añade -country-es al usuario para IP española (precios con IVA).
# BRIGHTDATA_PROXY_URL=http://brd-customer-XXX-zone-residential-country-es:PASSWORD@brd.superproxy.io:33335
# O por partes:
# BRIGHTDATA_PROXY_HOST=brd.superproxy.io
# BRIGHTDATA_PROXY_PORT=33335
# BRIGHTDATA_PROXY_USER=brd-customer-XXX-zone-residential-country-es
# BRIGHTDATA_PROXY_PASSWORD=

# Amazon Product Advertising / Creators API (PA-API 5)
AMAZON_API_ACCESS_KEY=
AMAZON_API_SECRET=
# AMAZON_PARTNER_TAG=  # opcional; por defecto usa AMAZON_ASSOCIATE_TAG
# AMAZON_CREATORS_STRICT=1  # sin fallback HTML si Creators no está listo

# Keepa API (alternativa oficial de histórico/precios)
KEEPA_API_KEY=

# Panel /admin: contraseña de sesión (cookie httpOnly).
# Si no defines ADMIN_PASSWORD, se usa CRON_SECRET.
ADMIN_PASSWORD=
# Secreto para /api/cron/* (y fallback de admin)
CRON_SECRET=

# Cron local (Mac): npm run cron:local:install
# Usa las mismas claves de arriba (.env.local). El scrape sale por tu IP de casa.
