# URL del proyecto, sin /rest/v1 (ejemplo: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
# Chat privado tuyo para avisos de cron fallido (habla con @userinfobot o /start al bot)
TELEGRAM_ADMIN_CHAT_ID=
# Canal o grupo para alertas de chollos (ej: -1001234567890 o @mi_canal)
TELEGRAM_CHANNEL_ID=
# Score mínimo para publicar en el canal (default 75)
TELEGRAM_MIN_SCORE=75
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/cazandor_de_ofertas_bot

# URL canónica del sitio (canonicals, OG, sitemap). Ej: https://cazaoferta.es
NEXT_PUBLIC_SITE_URL=
# Handle de redes para carruseles y CTAs (ej: @cazaoferta)
NEXT_PUBLIC_SOCIAL_HANDLE=@cazaoferta

AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=ES

# Días agotado en Amazon antes de desactivar el producto en el catálogo (default 14)
OUT_OF_STOCK_DEACTIVATE_DAYS=14

# Kiabi — chollos de moda (cron local: npm run cron:local:kiabi)
KIABI_DEALS_ENABLED=0
KIABI_MIN_DISCOUNT_PERCENT=10
# 1 = solo productos nuevos (+ bajadas de precio en listado); 0 = también re-sincroniza existentes
KIABI_NEW_PRODUCTS_ONLY=1
# Si DataDome bloquea Node, usa esta lista JSON como respaldo (ruta relativa al repo)
# KIABI_FALLBACK_ITEMS_JSON=scripts/local-cron/.kiabi-browser-items.json
# Máximo de productos a descubrir por feed (default 100; promociones suele tener ~81)
# KIABI_DISCOVERY_MAX_ITEMS=100
# Opcional: cookies del navegador (archivo con cabecera Cookie o Netscape)
# KIABI_COOKIES_FILE=
# Feed principal de promociones con precio tachado (hasta -50%)
# KIABI_FEED_URLS=https://www.kiabi.es/promociones_464410

# Carrefour: desactivado (Cloudflare bloquea scrape automático). Los productos CF- en catálogo
# se gestionan manualmente; retailer sigue disponible en admin sin extracción automática.

# auto = Creators (si hay keys) → Keepa → scraper HTML
# Para ofertas flash / «ventas rápidas» usa html (precio de la ficha Amazon).
PRICE_PROVIDER=html
# CP de entrega en amazon.es (fuerza precios con IVA desde IPs fuera de ES, p.ej. Vercel).
# AMAZON_ES_ZIP=28001

# Bright Data — proxy residencial para scrape Amazon en producción (Vercel).
# En el panel: Residential → Overview → host, user, password.
# Añade -country-es al usuario para IP española (precios con IVA).
# BRIGHTDATA_PROXY_URL=http://brd-customer-XXX-zone-residential-country-es:PASSWORD@brd.superproxy.io:33335
# O por partes:
# BRIGHTDATA_PROXY_HOST=brd.superproxy.io
# BRIGHTDATA_PROXY_PORT=33335
# BRIGHTDATA_PROXY_USER=brd-customer-XXX-zone-residential-country-es
# BRIGHTDATA_PROXY_PASSWORD=

# Amazon Product Advertising / Creators API (PA-API 5)
AMAZON_API_ACCESS_KEY=
AMAZON_API_SECRET=
# AMAZON_PARTNER_TAG=  # opcional; por defecto usa AMAZON_ASSOCIATE_TAG
# AMAZON_CREATORS_STRICT=1  # sin fallback HTML si Creators no está listo

# Keepa API (alternativa oficial de histórico/precios)
KEEPA_API_KEY=

# Panel /admin: contraseña de sesión (cookie httpOnly).
# Si no defines ADMIN_PASSWORD, se usa CRON_SECRET.
ADMIN_PASSWORD=
# Secreto para /api/cron/* (y fallback de admin)
CRON_SECRET=

# Cron local (Mac): npm run cron:local:install
# Usa las mismas claves de arriba (.env.local). El scrape sale por tu IP de casa.
