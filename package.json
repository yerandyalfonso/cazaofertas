{
  "name": "cazaofertas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "dev:caza": "next dev --port 3000 --hostname 127.0.0.1",
    "dev:chollos": "npm run dev -w chollosdehoy",
    "dev:all": "concurrently -n caza,chollos -c blue,green \"npm run dev:caza\" \"npm run dev:chollos\"",
    "setup:chollos-env": "bash scripts/sync-chollos-env.sh",
    "deploy:chollos": "bash scripts/deploy-chollos.sh",
    "build:chollos": "npm run build -w chollosdehoy",
    "build:all": "npm run build && npm run build:chollos",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local src/database/run-seed.ts",
    "seed:blog": "tsx --env-file=.env.local src/database/seed-blog.ts",
    "cron:local": "tsx --env-file=.env.local scripts/local-cron/run.ts",
    "cron:local:prices": "npm run cron:local -- check-prices",
    "cron:local:flash": "npm run cron:local -- flash-deals",
    "cron:local:miravia": "npm run cron:local -- miravia-deals",
    "cron:local:alerts": "npm run cron:local -- user-alerts",
    "cron:local:kiabi": "npm run cron:local -- kiabi-deals",
    "cron:local:telegram-flush": "npm run cron:local -- telegram-flush",
    "cron:local:kiabi-e2e": "tsx --env-file=.env.local scripts/local-cron/test-kiabi-e2e.ts",
    "cron:local:kiabi-real": "tsx --env-file=.env.local scripts/local-cron/run-kiabi-real-test.ts",
    "cron:local:kiabi-temp-install": "bash scripts/local-cron/install-kiabi-temp-cron.sh",
    "cron:local:kiabi-temp-uninstall": "bash scripts/local-cron/uninstall-kiabi-temp-cron.sh",
    "cron:local:install": "bash scripts/local-cron/install-macos.sh",
    "cron:local:install:high-freq": "bash scripts/local-cron/install-macos.high-frequency.sh",
    "cron:local:uninstall": "bash scripts/local-cron/uninstall-macos.sh",
    "cron:local:test-notify": "tsx --env-file=.env.local scripts/local-cron/test-notify.ts",
    "cron:local:test-facebook": "tsx --env-file=.env.local scripts/local-cron/test-facebook.ts",
    "cron:local:coupons": "npm run cron:local -- coupons-discover",
    "coupons:discover": "tsx --env-file=.env.local scripts/coupon-discovery/run.ts"
  },
  "dependencies": {
    "@cazaofertas/shared": "*",
    "@supabase/supabase-js": "^2.112.4",
    "@tiptap/extension-blockquote": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
